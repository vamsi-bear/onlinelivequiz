<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Internet access for Firebase -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="Live Quiz"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.OnlineLiveQuiz">

        <!-- Launcher Activity -->
        <activity
            android:name=".activities.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Registration Screen -->
        <activity
            android:name=".activities.RegisterActivity"
            android:exported="false" />

        <!-- Main Screen -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="false" />

        <!-- Quiz Screen -->
        <activity
            android:name=".activities.QuizActivity"
            android:exported="false" />

        <!-- Result Screen -->
        <activity
            android:name=".activities.ResultActivity"
            android:exported="false" />

        <!-- Leaderboard Screen -->
        <activity
            android:name=".activities.LeaderboardActivity"
            android:exported="false" />

        <!-- Profile Screen -->
        <activity
            android:name=".activities.ProfileActivity"
            android:exported="false" />

        <!-- Admin Screen -->
        <activity
            android:name=".activities.AdminActivity"
            android:exported="false" />

        <!-- Add Quiz Screen -->
        <activity
            android:name=".activities.AddQuizActivity"
            android:exported="false" />

        <!-- Add Question Screen -->
        <activity
            android:name=".activities.AddQuestionActivity"
            android:exported="false" />

    </application>

</manifest>